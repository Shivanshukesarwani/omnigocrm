{
  "name":"shivanshu/omnigocrm-backend",
  "type":"project",
  "description":"OmniGoCRM multi-tenant Laravel CRM backend",
  "require":{"php":"^8.3","laravel/framework":"^13.0","laravel/tinker":"^3.0","phpoffice/phpspreadsheet":"^5.10"},
  "require-dev":{"fakerphp/faker":"^1.23","laravel/pail":"^1.2","phpunit/phpunit":"^12.0"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "scripts":{"post-autoload-dump":["@php artisan package:discover --ansi"],"post-update-cmd":["@php artisan vendor:publish --tag=laravel-assets --ansi --force"],"test":"@php artisan test"},
  "minimum-stability":"stable","prefer-stable":true
}