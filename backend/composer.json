{
  "name": "omnigocrm/backend",
  "type": "project",
  "description": "OmniGoCRM multi-tenant SaaS CRM backend",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/" }
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"],
    "test": "@php artisan test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
