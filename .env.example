# OmniGoCRM Docker runtime secrets
OMNIGOCRM_DB_PASSWORD=replace-with-a-long-random-password
OMNIGOCRM_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Set these in EspoCRM administration/environment, never commit real values:
# omniGoCRMWhatsAppAccessToken=
# omniGoCRMWhatsAppAppSecret=
# omniGoCRMWhatsAppVerifyToken=
# omniGoCRMWhatsAppPhoneNumberId=
# omniGoCRMMetaLeadVerifyToken=
# omniGoCRMMetaLeadAppSecret=
# omniGoCRMMetaLeadApiKey=
# omniGoCRMMetaGraphVersion=
# omniGoCRMGoogleLeadApiKey=
# omniGoCRMStripeWebhookSecret=
# omniGoCRMRazorpayWebhookSecret=
