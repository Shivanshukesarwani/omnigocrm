{
    "fields": {
        "omniGoCRMProvider": {
            "type": "varchar",
            "maxLength": 100
        },
        "omniGoCRMExternalCallId": {
            "type": "varchar",
            "maxLength": 255
        },
        "omniGoCRMDisposition": {
            "type": "enum",
            "options": [
                "No Answer",
                "Connected",
                "Interested",
                "Follow Up",
                "Callback Requested",
                "Not Interested",
                "Wrong Number",
                "Do Not Call",
                "Qualified",
                "Converted"
            ],
            "displayAsLabel": true
        },
        "omniGoCRMRecordingStatus": {
            "type": "enum",
            "options": [
                "Not Available",
                "Requested",
                "Available",
                "Failed",
                "Deleted"
            ],
            "default": "Not Available",
            "displayAsLabel": true
        },
        "omniGoCRMRecordingExternalUrl": {
            "type": "url"
        },
        "omniGoCRMRecordingDuration": {
            "type": "int",
            "min": 0
        },
        "omniGoCRMRecordingConsentAt": {
            "type": "datetime"
        },
        "omniGoCRMPhoneNumber": {
            "type": "phone",
            "typeList": [
                "Mobile",
                "Work",
                "Other",
                "WhatsApp",
                "Phone"
            ],
            "isPersonalData": true
        },
        "omniGoCRMTranscript": {
            "type": "text",
            "isPersonalData": true
        },
        "omniGoCRMWorkspaceId": {
            "type": "varchar",
            "maxLength": 24,
            "readOnly": true,
            "index": true,
            "utility": true
        }
    },
    "indexes": {
        "externalCallId": {
            "columns": [
                "omniGoCRMExternalCallId",
                "deleted"
            ]
        },
        "provider": {
            "columns": [
                "omniGoCRMProvider",
                "deleted"
            ]
        },
        "omniGoCRMWorkspaceId": {
            "columns": [
                "omniGoCRMWorkspaceId",
                "deleted"
            ]
        }
    }
}
