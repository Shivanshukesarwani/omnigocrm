# OmniGoCRM image
# Use the supported CRM runtime so installation and entrypoint behavior
# remain aligned with the base platform.
ARG ESPOCRM_IMAGE=espocrm/espocrm:latest
FROM ${ESPOCRM_IMAGE}

LABEL org.opencontainers.image.title="OmniGoCRM" \
    org.opencontainers.image.description="OmniGoCRM omnichannel sales CRM"

USER root
WORKDIR /var/www/html

# Add OmniGoCRM modules and web client extensions.
COPY custom/ /var/www/html/custom/
COPY client/custom/ /var/www/html/client/custom/

# Use + rather than shell-semicolon escaping so this remains portable
# across Docker's /bin/sh implementations.
RUN chown -R www-data:www-data /var/www/html/custom /var/www/html/client/custom \
    && find /var/www/html/custom -type d -exec chmod 755 {} + \
    && find /var/www/html/custom -type f -exec chmod 644 {} + \
    && find /var/www/html/client/custom -type d -exec chmod 755 {} + \
    && find /var/www/html/client/custom -type f -exec chmod 644 {} +

# Keep the base runtime entrypoint and command.
