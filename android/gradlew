#!/bin/sh
set -eu

GRADLE_VERSION="9.8.0"
GRADLE_DIR="$PWD/.gradle-bootstrap"
GRADLE_HOME="$GRADLE_DIR/gradle-$GRADLE_VERSION"
GRADLE_ZIP="$GRADLE_DIR/gradle-$GRADLE_VERSION-bin.zip"

if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$GRADLE_DIR"
  if [ ! -f "$GRADLE_ZIP" ]; then
    curl -fsSL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$GRADLE_ZIP"
  fi
  rm -rf "$GRADLE_HOME"
  unzip -q "$GRADLE_ZIP" -d "$GRADLE_DIR"
fi

exec "$GRADLE_HOME/bin/gradle" "$@"
